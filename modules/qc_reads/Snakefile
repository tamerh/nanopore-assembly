"""
qc_reads — raw Nanopore read QC and filtering.

Stage 1. Inputs: raw FASTQ. Outputs: NanoPlot reports (pre/post filter)
and a length+quality+target_bases filtered FASTQ for downstream assembly.

Tools:
  - NanoPlot   read length / quality plots
  - Filtlong   length + quality filtering, optional subsampling

Adapter handling: pipeline assumes basecaller-level adapter trimming
(default behavior of Dorado/Guppy >= 6 and demuxers). No explicit
adapter-removal step. For data where this assumption may not hold, an
explicit adapter trimming step (e.g. Porechop_ABI between filtlong
and assembly) would be needed.
"""

OUTDIR = config["outdir"]
SAMPLES = config["samples"]


def raw_fastq(wildcards):
    return SAMPLES[wildcards.sample]["fastq"]


rule nanoplot_raw:
    """Read length and quality summary on the raw input FASTQ."""
    input:
        raw_fastq,
    output:
        html = f"{OUTDIR}/qc_reads/{{sample}}/nanoplot_raw/NanoPlot-report.html",
        stats = f"{OUTDIR}/qc_reads/{{sample}}/nanoplot_raw/NanoStats.txt",
    log:
        f"{OUTDIR}/qc_reads/{{sample}}/nanoplot_raw.log",
    threads: config["threads"]
    conda:
        "nanopore-assembly-qc-reads"
    params:
        outdir = lambda w: f"{OUTDIR}/qc_reads/{w.sample}/nanoplot_raw",
    shell:
        r"""
        NanoPlot \
            --fastq {input} \
            --outdir {params.outdir} \
            --threads {threads} \
            --tsv_stats \
            > {log} 2>&1
        """


rule filtlong:
    """Filter reads by length and mean quality; optional total-bases subsampling."""
    input:
        raw_fastq,
    output:
        f"{OUTDIR}/qc_reads/{{sample}}/filtered.fastq.gz",
    log:
        f"{OUTDIR}/qc_reads/{{sample}}/filtlong.log",
    threads: 1  # filtlong is single-threaded
    conda:
        "nanopore-assembly-qc-reads"
    params:
        min_length = config["read_filter"]["min_length"],
        min_mean_q = config["read_filter"]["min_mean_q"],
        target_arg = (
            f"--target_bases {config['read_filter']['target_bases']}"
            if config["read_filter"]["target_bases"] > 0
            else ""
        ),
    shell:
        r"""
        filtlong \
            --min_length {params.min_length} \
            --min_mean_q {params.min_mean_q} \
            {params.target_arg} \
            {input} 2> {log} \
            | gzip > {output}
        """


rule nanoplot_filtered:
    """Read length and quality summary on the filtered FASTQ — for before/after comparison."""
    input:
        rules.filtlong.output,
    output:
        html = f"{OUTDIR}/qc_reads/{{sample}}/nanoplot_filtered/NanoPlot-report.html",
        stats = f"{OUTDIR}/qc_reads/{{sample}}/nanoplot_filtered/NanoStats.txt",
    log:
        f"{OUTDIR}/qc_reads/{{sample}}/nanoplot_filtered.log",
    threads: config["threads"]
    conda:
        "nanopore-assembly-qc-reads"
    params:
        outdir = lambda w: f"{OUTDIR}/qc_reads/{w.sample}/nanoplot_filtered",
    shell:
        r"""
        NanoPlot \
            --fastq {input} \
            --outdir {params.outdir} \
            --threads {threads} \
            --tsv_stats \
            > {log} 2>&1
        """


rule qc_summary:
    """Normalize NanoPlot stats (raw + filtered) into a flat per-sample TSV.

    Splits NanoStats compound cells (e.g. 'Reads >Q15: 315 (76.1%) 7.1Mb')
    into separate columns, computes pct reads/bases retained by filtering,
    and emits a single-row TSV matching the shape of QUAST/CheckV outputs.
    Centralizes the messy NanoPlot parsing in one place — downstream
    consumers (e.g. the report) read this file, not NanoStats directly.
    """
    input:
        raw_stats = rules.nanoplot_raw.output.stats,
        filtered_stats = rules.nanoplot_filtered.output.stats,
    output:
        summary = f"{OUTDIR}/qc_reads/{{sample}}/qc_summary.tsv",
    log:
        f"{OUTDIR}/qc_reads/{{sample}}/qc_summary.log",
    threads: 1
    conda:
        "nanopore-assembly-qc-reads"
    script:
        "scripts/summarize_qc.py"


